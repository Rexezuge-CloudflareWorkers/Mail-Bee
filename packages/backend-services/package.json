    "./webhook/*": "./src/webhook/*.ts",
    "./digest": "./src/digest/index.ts",
    "./digest/*": "./src/digest/*.ts",
    "./processing": "./src/processing/index.ts",
    "./processing/*": "./src/processing/*.ts",
    "./drive": "./src/drive/index.ts",
    "./drive/*": "./src/drive/*.ts",
