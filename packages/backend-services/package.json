    "./forwarding/*": "./src/forwarding/*.ts",
    "./oauth2": "./src/oauth2/index.ts",
    "./oauth2/*": "./src/oauth2/*.ts",
    "./subscription": "./src/subscription/index.ts",
    "./subscription/*": "./src/subscription/*.ts",
    "./user": "./src/user/index.ts",
    "./user/*": "./src/user/*.ts",
    "./analytics": "./src/analytics/index.ts",
    "./analytics/*": "./src/analytics/*.ts",
    "./integration": "./src/integration/index.ts",
    "./integration/*": "./src/integration/*.ts",
    "./provider": "./src/provider/index.ts",
