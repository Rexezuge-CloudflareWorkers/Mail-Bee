{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mail-bee",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "routes": [],
  "placement": {
    "mode": "off",
  },
  "assets": {
    "directory": "../../apps/web/dist/",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRON_TASKS",
        "class_name": "CronTasksWorker",
      },
      {
        "name": "OAUTH2_TOKEN_REFRESHERS",
        "class_name": "OAuth2TokenRefreshWorker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1778260000",
      "new_sqlite_classes": ["CronTasksWorker", "OAuth2TokenRefreshWorker"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "mail-bee-db",
      "migrations_dir": "../../migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH2_TOKEN_CACHE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "workflows": [
    {
      "binding": "EMAIL_PROCESSING_WORKFLOW",
      "name": "mail-bee-email-forwarding",
      "class_name": "EmailProcessingWorkflow",
    },
  ],
  "queues": {
    "producers": [
      {
        "queue": "mail-bee-email-events",
        "binding": "EMAIL_EVENTS_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "mail-bee-email-events",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
      },
    ],
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "secrets_store_secrets": [
    {
      "binding": "AES_ENCRYPTION_KEY_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "mail-bee-aes-encryption-key",
    },
  ],
  "vars": {
    "DEBUG_MODE": "false",
    "POLICY_AUD": "your-cloudflare-zero-trust-application-aud",
    "TEAM_DOMAIN": "https://your-cloudflare-zero-trust-team-domain.cloudflareaccess.com",
    "PUBLIC_BASE_URL": "",
    "SEND_FROM": "",
    "MAX_APPLICATIONS_PER_USER": "20",
    "OAUTH2_STATE_EXPIRY_MINUTES": "15",
    "GMAIL_WATCH_RENEWAL_WINDOW_HOURS": "48",
    "OUTLOOK_SUBSCRIPTION_RENEWAL_WINDOW_HOURS": "24",
    "OUTLOOK_SUBSCRIPTION_TTL_DAYS": "6",
    "OAUTH2_ACCESS_TOKEN_REFRESH_WINDOW_SECONDS": "900",
    "OAUTH2_ACCESS_TOKEN_MIN_VALID_SECONDS": "60",
    "OAUTH2_ACCESS_TOKEN_FALLBACK_TTL_SECONDS": "3600",
    "OAUTH2_TOKEN_REFRESH_BATCH_SIZE": "25",
  },
}
