{
  "name": "@mail-bee/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-spa-shell-stub.mjs && pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm run checks:fast && pnpm run test:coverage && pnpm run test:web",
    "checks:fast": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run validate:migrations && pnpm run verify:spa-shell",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:scripts && pnpm run typecheck:functions",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "verify:spa-shell": "tsx scripts/build/verify-spa-shell.ts",
    "validate:migrations": "tsx scripts/migrations/verify-migrations.ts",
    "migrations:lock": "tsx scripts/migrations/verify-migrations.ts --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:web": "vitest run --config vitest.web.config.mts",
    "test:web:coverage": "vitest run --coverage --config vitest.web.config.mts",
    "lint": "node scripts/lint-workspaces.mjs",
    "lint:fix": "node scripts/lint-workspaces.mjs --fix",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv && node scripts/postprocess-types.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@rexezuge/d1": "1.9.4",
    "@rexezuge/errors": "1.9.4",
    "@rexezuge/http": "1.9.4",
    "@rexezuge/i18n": "1.9.4",
    "@rexezuge/identity": "1.9.4",
    "@rexezuge/runtime": "1.9.4",
    "@rexezuge/shared": "1.9.4",
    "@rexezuge/tooling": "1.9.4",
    "@rexezuge/web": "1.9.4",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.14.0",
    "jsdom": "^31.0.1",
    "jsonc-parser": "3.3.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "4.1.11",
    "wrangler": "4.166.0"
  },
  "packageManager": "pnpm@11.2.2"
}
